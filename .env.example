# Smart Crossing - segreti e indirizzi. Copiate questo file in ".env" (stessa cartella) e compilatelo.
# Il file .env NON va su GitHub (e' nel .gitignore). Una variabile per riga, commenti su righe a parte.
# Lo leggono: src/server/server.py e flask_app.py, src/client/client.py, il nodo (src/node/python/config.py).

# Token condiviso tra server e dispositivi (header "Authorization: Bearer <token>").
# Serve per tutto cio' che scrive sul server: POST dei nodi, /api/traffic del client.py, "Simula pericolo".
# Pagine e letture della dashboard restano pubbliche. Sulla board: copiate il .env accanto a config.json.
SC_TOKEN=cambiate-questo-token

# Dove il client.py manda i conteggi dei 12 nodi simulati (vuoto = server su PythonAnywhere).
# Per il server sul vostro PC: SC_TRAFFIC_URL=http://localhost:8000/api/traffic
SC_TRAFFIC_URL=

# Chiave HMAC dei messaggi P2P tra incroci (UDP / ESP-NOW). Lasciatela vuota se usate la UNO R4 come
# incrocio-2: il suo firmware non firma i messaggi e il nodo li scarterebbe. Deve essere uguale su tutti i nodi.
SC_P2P_KEY=

# Facoltative per il server: database e topologia (default: accanto a server.py)
# SC_DB=
# SC_TOPOLOGY=
